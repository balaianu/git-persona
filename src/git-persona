#!/bin/bash

# git-persona: manage multiple git identities with SSH keys and includeIf
# Usage: git-persona <command> [args]
# Version: 1.4.4
# License: MIT
# Dependencies: bash 3.2+, git 2.13+, openssh (ssh-keygen)

set -euo pipefail

VERSION="1.4.4"

: "${HOME:?HOME is not set}"

CONFIG_DIR="${HOME}/.config/git-persona"
PROFILES_DIR="${CONFIG_DIR}/profiles"
SSH_DIR="${HOME}/.ssh"
GITCONFIG="${HOME}/.gitconfig"

TMP_FILE=""
RB_PROFILE=""
RB_CONF=""
INCLUDE_REASSIGNED=0

# Profile fields populated by load_conf.
P_id="" P_name="" P_email="" P_base_dir="" P_key_file="" P_profile_file="" P_key_owned=""

trap '[ -z "$TMP_FILE" ] || rm -f "$TMP_FILE"' EXIT

# ── Output helpers ───────────────────────────────────────────────────────────

err() {
    printf '%s\n' "$*" >&2
}

die() {
    err "$@"
    exit 1
}

usage() {
    cat << 'EOF'
Usage: git-persona <command> [args]

Commands:
  create <id> <name> <email> [base_dir] [--no-ssh-key]
                                        Create a new profile (generates SSH key by default)
  list                                  List all profiles
  delete <id> [--with-keys]             Delete a profile (keeps SSH key by default)
  use <id>                              Apply profile to current repo
  use-folder <id> <folder>              Apply profile to a folder via includeIf
  current                               Show the profile for the current directory
  version                               Show the version of git-persona

Flags:
  --no-ssh-key    (create)  Skip SSH key generation
  --with-keys     (delete)  Also remove the SSH key pair

Examples:
  git persona create work "Work Name" work@example.com ~/work
  git persona create personal "Personal Name" personal@example.com ~/personal --no-ssh-key
  git persona use work
  git persona use-folder work ~/work
  git persona current
  git persona delete work --with-keys
  git persona version
EOF
}

# ── Validation ───────────────────────────────────────────────────────────────

init() {
    mkdir -p "$PROFILES_DIR"
}

profile_exists() {
    local id="$1"
    [ -f "${PROFILES_DIR}/${id}.conf" ]
}

# Alphanumeric, hyphens, underscores only: the ID becomes part of file paths.
valid_id() {
    local id="$1"
    [ -n "$id" ] || return 1
    [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]]
}

has_control_chars() {
    [[ "$1" =~ [[:cntrl:]] ]]
}

# A newline in a value would let it inject extra sections into a gitconfig.
valid_text() {
    [ -n "$1" ] && ! has_control_chars "$1"
}

# The directory ends up inside a gitconfig section header, where quotes and
# backslashes break parsing and glob characters silently widen the match.
valid_gitdir() {
    local dir="$1"
    [ -n "$dir" ] || return 1
    has_control_chars "$dir" && return 1
    case "$dir" in
        *'"'* | *'\'* | *'*'* | *'?'* | *'['*) return 1 ;;
    esac
    return 0
}

# ── Profile conf files ───────────────────────────────────────────────────────

# Escape a value for embedding inside double quotes in a conf file. Backslash
# first, because it is the escape character for the other three.
shell_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\$/\\\$}"
    s="${s//\`/\\\`}"
    s="${s//\"/\\\"}"
    printf '%s' "$s"
}

unescape_value() {
    local s="$1"
    local bs='\' dq='"' ds='$' bt='`' mark=$'\x01'
    s="${s//"$bs$bs"/$mark}"
    s="${s//"$bs$ds"/$ds}"
    s="${s//"$bs$bt"/$bt}"
    s="${s//"$bs$dq"/$dq}"
    s="${s//$mark/$bs}"
    printf '%s' "$s"
}

# Parse a conf file without sourcing it, so a tampered or corrupt file can
# never execute code. Conf files stay bash-sourceable for backwards
# compatibility. CR is treated as a line break so CRLF and CR-only files parse.
load_conf() {
    local conf="$1"
    local line key val data
    local re='^([a-z_]+)="(.*)"$'
    local cr=$'\r' nl=$'\n'

    P_id="" P_name="" P_email="" P_base_dir="" P_key_file="" P_profile_file="" P_key_owned=""
    [ -f "$conf" ] || return 1

    data="$(cat "$conf" 2>/dev/null)" || return 1
    data="${data//$cr/$nl}"

    while IFS= read -r line || [ -n "$line" ]; do
        if [[ "$line" =~ $re ]]; then
            key="${BASH_REMATCH[1]}"
            val="$(unescape_value "${BASH_REMATCH[2]}")"
            case "$key" in
                id) P_id="$val" ;;
                name) P_name="$val" ;;
                email) P_email="$val" ;;
                base_dir) P_base_dir="$val" ;;
                key_file) P_key_file="$val" ;;
                profile_file) P_profile_file="$val" ;;
                key_owned) P_key_owned="$val" ;;
            esac
        fi
    done <<< "$data"
    return 0
}

# The profile gitconfig path is fully determined by the ID, so the conf value
# is never trusted: a damaged or tampered conf must neither leave a dangling
# includeIf behind nor point delete at a file outside the profiles directory.
# Like load_conf, but also rejects confs that parsed to nothing.
load_conf_valid() {
    load_conf "$1" && [ -n "$P_id" ]
}

load_profile() {
    local derived="${PROFILES_DIR}/${1}.gitconfig"
    load_conf "${PROFILES_DIR}/${1}.conf" || return 1
    if [ -n "$P_profile_file" ] && [ "$P_profile_file" != "$derived" ]; then
        err "Warning: ignoring unexpected profile_file in ${1}.conf; using $derived"
    fi
    P_profile_file="$derived"
}

# ── SSH command ──────────────────────────────────────────────────────────────

# core.sshCommand is run through a shell, so the key path must be quoted.
ssh_command_for() {
    local q="'"
    local key="${1//$q/$q\\$q$q}"
    printf "ssh -i '%s' -o IdentitiesOnly=yes" "$key"
}

# Versions before 1.4.0 wrote the key path unquoted.
ssh_command_matches() {
    local cmd="$1" key="$2"
    [ "$cmd" = "$(ssh_command_for "$key")" ] ||
        [ "$cmd" = "ssh -i ${key} -o IdentitiesOnly=yes" ]
}

write_profile_gitconfig() {
    local file="$1" name="$2" email="$3" key="$4"
    rm -f "$file"
    # git escapes every value correctly, unlike a hand-written heredoc.
    git config --file "$file" user.name "$name"
    git config --file "$file" user.email "$email"
    if [ -n "$key" ]; then
        git config --file "$file" core.sshCommand "$(ssh_command_for "$key")"
    fi
}

# ── ~/.gitconfig editing ─────────────────────────────────────────────────────

# Follow symlinks so edits land in the real file. Dotfile managers commonly
# symlink ~/.gitconfig, and replacing the link would silently detach it.
resolve_link() {
    local p="$1" t i=0
    while [ -L "$p" ] && [ "$i" -lt 40 ]; do
        t="$(readlink "$p")"
        case "$t" in
            /*) p="$t" ;;
            *) p="$(dirname "$p")/$t" ;;
        esac
        i=$((i + 1))
    done
    printf '%s' "$p"
}

new_tmp_file() {
    mkdir -p "$CONFIG_DIR"
    TMP_FILE="$(mktemp "${CONFIG_DIR}/gitconfig.XXXXXX")"
}

# Copy the rewritten file over the original in place, keeping its symlink,
# mode and ownership, and keep one backup of the previous content.
commit_gitconfig() {
    local target made_backup=0
    target="$(resolve_link "$GITCONFIG")"

    if [ -f "$target" ] && cmp -s "$TMP_FILE" "$target"; then
        rm -f "$TMP_FILE"
        TMP_FILE=""
        return 0
    fi
    if [ -f "$target" ]; then
        cp -p "$target" "${CONFIG_DIR}/gitconfig.bak"
        made_backup=1
    fi
    if ! cat "$TMP_FILE" > "$target"; then
        if [ "$made_backup" = 1 ]; then
            err "Failed to write $target. The previous content is saved in ${CONFIG_DIR}/gitconfig.bak"
        else
            err "Failed to write $target."
        fi
        return 1
    fi
    rm -f "$TMP_FILE"
    TMP_FILE=""
}

# The editors below match whole lines, so CRLF would make them miss existing
# blocks and mix line endings. Refuse instead of guessing.
require_lf_gitconfig() {
    local cr=$'\r' target
    target="$(resolve_link "$GITCONFIG")"
    [ -f "$target" ] || return 0
    if grep -q "$cr" "$target"; then
        die "Error: $GITCONFIG contains carriage returns (CRLF line endings). Convert it to LF, for example with dos2unix, and run the command again."
    fi
}

dir_within() {
    case "$1" in
        "$2" | "$2"/*) return 0 ;;
    esac
    return 1
}

lowercase() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# Parse a "path" line the way git reads it: any spacing around "=", any key
# casing, optional double quotes, and unquoted values end at "#" or ";".
parse_path_line() {
    local re='^[[:space:]]*[Pp][Aa][Tt][Hh][[:space:]]*=[[:space:]]*(.*)$'
    local v rest out="" c
    [[ "$1" =~ $re ]] || return 1
    v="${BASH_REMATCH[1]}"

    if [ "${v:0:1}" = '"' ]; then
        rest="${v:1}"
        while [ -n "$rest" ]; do
            c="${rest:0:1}"
            rest="${rest:1}"
            case "$c" in
                \\)
                    out="${out}${rest:0:1}"
                    rest="${rest:1}"
                    ;;
                '"') break ;;
                *) out="${out}${c}" ;;
            esac
        done
        PATH_VALUE="$out"
    else
        v="${v%%[#;]*}"
        PATH_VALUE="${v%"${v##*[![:space:]]}"}"
    fi
    return 0
}

# Inverse of parse_path_line: quote only when git would otherwise misread it.
format_path_value() {
    local v="$1"
    case "$v" in
        *[\#\;\"\\]* | " "* | *" ")
            v="${v//\\/\\\\}"
            v="${v//\"/\\\"}"
            printf '"%s"' "$v"
            ;;
        *) printf '%s' "$v" ;;
    esac
}

is_section_start() {
    local t="${1#"${1%%[![:space:]]*}"}"
    [ "${t:0:1}" = "[" ]
}

is_includeif_header() {
    local re='^[[:space:]]*\[[iI][nN][cC][lL][uU][dD][eE][iI][fF][[:space:]]+"'
    [[ "$1" =~ $re ]]
}

# Scan ~/.gitconfig for [includeIf "gitdir:DIR/"] blocks matching current_dir
# and print the profile_file of the last match (git applies later includes
# last, so the last one wins). ~/.gitconfig is the source of truth for which
# folders map to which profile; base_dir in .conf can go stale.
match_includefile() {
    local current_dir="$1"
    local physical_dir="$2"
    [ -f "$GITCONFIG" ] || return 0

    local in_block=0 icase=0
    local block_dir="" block_phys="" result=""
    local line inner cur blk
    local cr=$'\r'

    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%"$cr"}"

        if is_includeif_header "$line"; then
            in_block=0
            inner="${line#*\"}"
            inner="${inner%\"*}"
            icase=0
            case "$inner" in
                gitdir:*) block_dir="${inner#gitdir:}" ;;
                gitdir/i:*) block_dir="${inner#gitdir/i:}"; icase=1 ;;
                *) continue ;;
            esac
            block_dir="${block_dir%/}"
            case "$block_dir" in
                "~/"*) block_dir="${HOME}/${block_dir#\~/}" ;;
            esac
            block_phys=""
            if [ -d "$block_dir" ]; then
                block_phys="$(cd "$block_dir" && pwd -P)" || block_phys=""
            fi
            in_block=1
            continue
        fi

        if is_section_start "$line"; then
            in_block=0
            continue
        fi

        if [ "$in_block" = 1 ] && parse_path_line "$line"; then
            for cur in "$current_dir" "$physical_dir"; do
                for blk in "$block_dir" "$block_phys"; do
                    [ -n "$blk" ] || continue
                    if [ "$icase" = 1 ]; then
                        if dir_within "$(lowercase "$cur")" "$(lowercase "$blk")"; then
                            result="$PATH_VALUE"
                        fi
                    elif dir_within "$cur" "$blk"; then
                        result="$PATH_VALUE"
                    fi
                done
            done
        fi
    done < "$GITCONFIG"

    printf '%s' "$result"
}

add_include_if() {
    local dir="$1"
    local profile_file="$2"
    local header="[includeIf \"gitdir:${dir}/\"]"

    INCLUDE_REASSIGNED=0
    new_tmp_file

    # - Same path      -> no-op (true dedup).
    # - Different path -> update the path line in place (reassignment).
    # - No match       -> append a new block.
    local src="$GITCONFIG"
    [ -f "$src" ] || src=/dev/null
    local found_header=0 updated=0 seen_path=0
    local line t inner

    while IFS= read -r line || [ -n "$line" ]; do
        if [ "$found_header" = 1 ]; then
            if is_section_start "$line"; then
                # The matching header had no path line; a path further down
                # belongs to another section and must not be touched.
                found_header=0
            elif parse_path_line "$line"; then
                # Git applies every path in a section and the last one wins,
                # so the first becomes ours and any later one is dropped.
                if [ "$seen_path" = 0 ]; then
                    seen_path=1
                    updated=1
                    if [ "$PATH_VALUE" = "$profile_file" ]; then
                        printf '%s\n' "$line"
                    else
                        printf '    path = %s\n' "$(format_path_value "$profile_file")"
                        INCLUDE_REASSIGNED=1
                    fi
                elif [ "$PATH_VALUE" != "$profile_file" ]; then
                    INCLUDE_REASSIGNED=1
                fi
                continue
            else
                printf '%s\n' "$line"
                continue
            fi
        fi

        if is_includeif_header "$line"; then
            inner="${line#*\"}"
            inner="${inner%\"*}"
            if [ "$inner" = "gitdir:${dir}/" ]; then
                found_header=1
                seen_path=0
            fi
        fi
        printf '%s\n' "$line"
    done < "$src" > "$TMP_FILE"

    if [ "$updated" = 0 ]; then
        printf '\n%s\n    path = %s\n' "$header" "$(format_path_value "$profile_file")" >> "$TMP_FILE"
    fi

    commit_gitconfig
}

_blanks=0

flush_blanks() {
    while [ "$_blanks" -gt 0 ]; do
        printf '\n'
        _blanks=$((_blanks - 1))
    done
}

# Write out (or drop) the buffered includeIf block. A block is dropped when
# its only path is profile_file; a block that also has other paths just loses
# our line. Blank lines at the end of a dropped block are the separator before
# the next section and are kept.
finish_block() {
    local profile_file="$1"
    local nl=$'\n'
    local line kept="" keptn="" body probe
    local ours=0 others=0 tb=0

    if [ -n "$block_buf" ]; then
        body="${block_buf%"$nl"}"
        while IFS= read -r line || [ -n "$line" ]; do
            if parse_path_line "$line"; then
                if [ "$PATH_VALUE" = "$profile_file" ]; then
                    ours=1
                    continue
                fi
                others=1
            fi
            kept="${kept}${line}${nl}"
            # Whitespace-only lines are separators too.
            if [ -z "${line//[[:space:]]/}" ]; then
                keptn="${keptn}${nl}"
            else
                keptn="${keptn}${line}${nl}"
            fi
        done <<< "$body"
    fi

    if [ "$ours" = 1 ] && [ "$others" = 0 ]; then
        # Drop the separator blank line add_include_if put in front of it.
        if [ "$_blanks" -gt 0 ]; then
            _blanks=$((_blanks - 1))
        fi
        probe="$keptn"
        while [ "${probe%"$nl$nl"}" != "$probe" ]; do
            probe="${probe%"$nl"}"
            tb=$((tb + 1))
        done
        if [ "$probe" = "$nl" ]; then
            tb=$((tb + 1))
        fi
        _blanks=$((_blanks + tb))
    else
        flush_blanks
        printf '%s\n' "$saved_header"
        printf '%s' "$kept"
    fi
}

# Remove every [includeIf] block whose path points at profile_file. Everything
# else in the file, including blank lines, is left untouched.
remove_include_if() {
    local profile_file="$1"
    [ -f "$GITCONFIG" ] || return 0

    new_tmp_file
    local in_block=0 saved_header="" block_buf=""
    local line nl=$'\n'

    _blanks=0
    while IFS= read -r line || [ -n "$line" ]; do
        if [ "$in_block" = 1 ]; then
            if is_section_start "$line"; then
                finish_block "$profile_file"
                in_block=0
            else
                # A blank line does not end a section in git, so keep
                # collecting until the next header.
                block_buf="${block_buf}${line}${nl}"
                continue
            fi
        fi

        if is_includeif_header "$line"; then
            in_block=1
            saved_header="$line"
            block_buf=""
            continue
        fi

        if [ -z "$line" ]; then
            _blanks=$((_blanks + 1))
            continue
        fi

        flush_blanks
        printf '%s\n' "$line"
    done < "$GITCONFIG" > "$TMP_FILE"

    {
        if [ "$in_block" = 1 ]; then
            finish_block "$profile_file"
        fi
        flush_blanks
    } >> "$TMP_FILE"

    commit_gitconfig
}

# ── Commands ─────────────────────────────────────────────────────────────────

rollback_create() {
    [ -z "$RB_PROFILE" ] || rm -f "$RB_PROFILE"
    [ -z "$RB_CONF" ] || rm -f "$RB_CONF"
    err "Profile creation failed; partial profile files were removed."
    err "Any SSH key that was already generated has been kept."
}

cmd_create() {
    local generate_key=true
    local positional=()
    local arg

    for arg in "$@"; do
        case "$arg" in
            --no-ssh-key)
                generate_key=false
                ;;
            --*)
                die "Unknown option: $arg"
                ;;
            *)
                positional+=("$arg")
                ;;
        esac
    done

    if [ "${#positional[@]}" -lt 3 ] || [ "${#positional[@]}" -gt 4 ]; then
        die "Usage: git-persona create <id> <name> <email> [base_dir] [--no-ssh-key]"
    fi

    local id="${positional[0]}"
    local name="${positional[1]}"
    local email="${positional[2]}"
    local base_dir

    if ! valid_id "$id"; then
        die "Error: profile ID '$id' is invalid. Use only letters, numbers, hyphens, and underscores."
    fi
    if ! valid_text "$name"; then
        die "Error: name is empty or contains control characters."
    fi
    if ! valid_text "$email"; then
        die "Error: email is empty or contains control characters."
    fi

    if [ "${#positional[@]}" -ge 4 ]; then
        base_dir="${positional[3]}"
    else
        base_dir="${HOME}/git-profiles/${id}"
        mkdir -p "${HOME}/git-profiles"
    fi

    local orig_base_dir="$base_dir"
    while [ "${base_dir%/}" != "$base_dir" ]; do
        base_dir="${base_dir%/}"
    done
    if [ -z "$base_dir" ]; then
        die "Error: base directory '$orig_base_dir' is empty or the filesystem root."
    fi
    # The leaf may not exist yet (mkdir -p below creates it), but the parent
    # must exist. This catches relative paths and typos without rejecting the
    # common case of creating a new project folder.
    case "${base_dir##*/}" in
        . | ..) die "Error: base directory '$base_dir' must end in a real folder name, not '.' or '..'." ;;
    esac
    local parent_dir="${base_dir%/*}"
    if [ "$parent_dir" = "$base_dir" ]; then
        die "Error: base directory '$base_dir' is not an absolute path."
    fi
    [ -n "$parent_dir" ] || parent_dir="/"
    if [ ! -d "$parent_dir" ]; then
        die "Error: parent directory '$parent_dir' does not exist."
    fi
    parent_dir="$(cd "$parent_dir" && pwd)"
    base_dir="${parent_dir%/}/${base_dir##*/}"
    if ! valid_gitdir "$base_dir"; then
        die "Error: base directory '$base_dir' contains characters that cannot be used in an includeIf rule (quotes, backslashes, * ? [)."
    fi

    require_lf_gitconfig

    local key_path="${SSH_DIR}/id_ed25519_git_${id}"
    local key_file=""
    local key_owned=0
    local profile_file="${PROFILES_DIR}/${id}.gitconfig"
    local conf_file="${PROFILES_DIR}/${id}.conf"

    if [ "$generate_key" = true ]; then
        key_file="$key_path"
        # A key that already exists belongs to the user, not to this profile,
        # so delete --with-keys must never remove it.
        if [ ! -e "$key_path" ] && [ ! -L "$key_path" ]; then
            key_owned=1
        fi
    fi

    init

    if profile_exists "$id"; then
        die "Profile '$id' already exists."
    fi

    RB_PROFILE="$profile_file"
    RB_CONF="$conf_file"
    set -E
    trap rollback_create ERR

    write_profile_gitconfig "$profile_file" "$name" "$email" "$key_file"

    printf '%s\n' \
        "id=\"${id}\"" \
        "name=\"$(shell_escape "$name")\"" \
        "email=\"$(shell_escape "$email")\"" \
        "base_dir=\"$(shell_escape "$base_dir")\"" \
        "key_file=\"$(shell_escape "$key_file")\"" \
        "profile_file=\"$(shell_escape "$profile_file")\"" \
        "key_owned=\"${key_owned}\"" > "$conf_file"

    mkdir -p "$base_dir"

    if [ -n "$key_file" ]; then
        if [ "$key_owned" = 1 ]; then
            if [ ! -d "$SSH_DIR" ]; then
                mkdir -p "$SSH_DIR"
                chmod 700 "$SSH_DIR"
            fi
            ssh-keygen -t ed25519 -C "$email" -f "$key_file" -N ""
        else
            echo "SSH key already exists at $key_file"
        fi
    fi

    add_include_if "$base_dir" "$profile_file"

    trap - ERR
    set +E

    echo "Profile '$id' created."
    echo "  Base directory: $base_dir"
    if [ -n "$key_file" ]; then
        echo "  SSH key:        $key_file"
        echo "  Public key:     ${key_file}.pub"
        if [ -f "${key_file}.pub" ]; then
            echo ""
            echo "Add this public key to GitHub:"
            cat "${key_file}.pub"
        fi
        echo ""
    else
        echo "  SSH key:        (none — --no-ssh-key was set)"
        echo ""
    fi
    echo "Put repos under $base_dir to automatically use this profile."
    if [ "$INCLUDE_REASSIGNED" = 1 ]; then
        echo "Note: this folder was previously assigned to a different profile."
    fi
}

cmd_list() {
    local count=0
    local conf

    echo "Profiles:"
    for conf in "${PROFILES_DIR}"/*.conf; do
        [ -f "$conf" ] || continue
        if ! load_conf_valid "$conf"; then
            err "Warning: skipping unreadable or malformed $conf"
            continue
        fi
        echo "  ${P_id}"
        echo "    name:     ${P_name}"
        echo "    email:    ${P_email}"
        echo "    base_dir: ${P_base_dir}"
        echo "    key:      ${P_key_file:-(none)}"
        count=$((count + 1))
    done

    if [ "$count" -eq 0 ]; then
        echo "No profiles found."
    fi
}

cmd_delete() {
    local remove_keys=false
    local id=""
    local arg

    for arg in "$@"; do
        case "$arg" in
            --with-keys)
                remove_keys=true
                ;;
            --*)
                die "Unknown option: $arg"
                ;;
            *)
                if [ -n "$id" ]; then
                    die "Usage: git-persona delete <id> [--with-keys]"
                fi
                id="$arg"
                ;;
        esac
    done

    if [ -z "$id" ]; then
        die "Usage: git-persona delete <id> [--with-keys]"
    fi

    if ! valid_id "$id"; then
        die "Error: profile ID '$id' is invalid."
    fi

    if ! profile_exists "$id"; then
        die "Profile '$id' not found."
    fi

    require_lf_gitconfig

    load_profile "$id" || die "Error: profile '$id' could not be read."
    local key_file="$P_key_file"
    local profile_file="$P_profile_file"
    local base_dir="$P_base_dir"
    local key_name="${key_file#"${SSH_DIR}"/}"

    # Unlink from ~/.gitconfig first so a failure there leaves the profile
    # intact instead of a dangling includeIf.
    if [ -n "$profile_file" ]; then
        remove_include_if "$profile_file"
    fi
    case "$profile_file" in
        "${PROFILES_DIR}"/*) rm -f "$profile_file" ;;
    esac
    rm -f "${PROFILES_DIR}/${id}.conf"

    if [ -z "$key_file" ]; then
        echo "No SSH key is associated with this profile."
    elif [ "$remove_keys" != true ]; then
        echo "SSH key kept: $key_file (use --with-keys to also remove it)"
    elif [ "$P_key_owned" != "1" ]; then
        # Confs from before 1.4.0 have no key_owned field, and there is no way
        # to tell whether git-persona generated their key, so keep it.
        echo "SSH key kept: $key_file (not recorded as generated by git-persona; remove it manually if you are sure)"
    elif ! [[ "$key_name" =~ ^id_ed25519_git_[A-Za-z0-9_-]+$ ]]; then
        # A damaged conf must not be able to point rm at an arbitrary file.
        err "Refusing to remove $key_file: not a git-persona key under $SSH_DIR"
    else
        rm -f "$key_file" "${key_file}.pub"
        echo "SSH key removed: $key_file"
    fi

    echo "Profile '$id' deleted."
    echo "Note: base directory $base_dir was not removed."
}

cmd_use() {
    if [ $# -ne 1 ]; then
        die "Usage: git-persona use <id>"
    fi

    local id="$1"

    if ! valid_id "$id"; then
        die "Error: profile ID '$id' is invalid."
    fi

    if ! profile_exists "$id"; then
        die "Profile '$id' not found."
    fi

    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        die "Not a git repository. Run this from inside a repo."
    fi

    load_profile "$id" || die "Error: profile '$id' could not be read."

    git config user.name "$P_name"
    git config user.email "$P_email"
    if [ -n "$P_key_file" ] && [ -f "$P_key_file" ]; then
        git config core.sshCommand "$(ssh_command_for "$P_key_file")"
    else
        if [ -n "$P_key_file" ]; then
            err "Warning: SSH key $P_key_file not found; core.sshCommand was not set."
        fi
        # Clear any previous sshCommand so we don't push with a stale key
        git config --unset core.sshCommand 2>/dev/null || true
    fi

    echo "Profile '$id' applied to current repo."
}

cmd_use_folder() {
    if [ $# -ne 2 ]; then
        die "Usage: git-persona use-folder <id> <folder>"
    fi

    local id="$1"
    local folder="$2"

    if ! valid_id "$id"; then
        die "Error: profile ID '$id' is invalid."
    fi

    if ! profile_exists "$id"; then
        die "Profile '$id' not found."
    fi

    if [ ! -d "$folder" ]; then
        die "Folder does not exist: $folder"
    fi

    folder="$(cd "$folder" && pwd)"
    if ! valid_gitdir "$folder"; then
        die "Error: folder '$folder' contains characters that cannot be used in an includeIf rule (quotes, backslashes, * ? [)."
    fi

    require_lf_gitconfig
    load_profile "$id" || die "Error: profile '$id' could not be read."

    add_include_if "$folder" "$P_profile_file"

    echo "Profile '$id' applied to folder: $folder"
    if [ "$INCLUDE_REASSIGNED" = 1 ]; then
        echo "Note: this folder was previously assigned to a different profile."
    fi
    echo "Any git repo under this folder will automatically use this profile."
}

print_current() {
    local label="$1"
    echo "${label}: ${P_id}"
    echo "  name:  ${P_name}"
    echo "  email: ${P_email}"
    echo "  key:   ${P_key_file:-(none)}"
}

cmd_current() {
    local current_dir physical_dir
    current_dir="$(pwd)"
    physical_dir="$(pwd -P)"

    local git_name="" git_email="" ssh_cmd="" in_repo=0

    if git rev-parse --git-dir >/dev/null 2>&1; then
        in_repo=1
        git_name="$(git config user.name 2>/dev/null || true)"
        git_email="$(git config user.email 2>/dev/null || true)"
        ssh_cmd="$(git config core.sshCommand 2>/dev/null || true)"
    fi

    local conf

    # Pass 1: strongest signal. The exact SSH command identifies a profile
    # even when several share the same name+email, and exact comparison keeps
    # a key path from matching another key it is a prefix of.
    if [ -n "$ssh_cmd" ]; then
        for conf in "${PROFILES_DIR}"/*.conf; do
            [ -f "$conf" ] || continue
            load_conf_valid "$conf" || continue
            if [ -n "$P_key_file" ] && ssh_command_matches "$ssh_cmd" "$P_key_file"; then
                print_current "Current profile"
                return 0
            fi
        done
    fi

    # Pass 2: weaker signal. When multiple profiles share name+email the
    # first match wins; there is no way to tell them apart.
    if [ -n "$git_name" ] && [ -n "$git_email" ]; then
        for conf in "${PROFILES_DIR}"/*.conf; do
            [ -f "$conf" ] || continue
            load_conf_valid "$conf" || continue
            if [ "$P_name" = "$git_name" ] && [ "$P_email" = "$git_email" ]; then
                print_current "Current profile"
                return 0
            fi
        done
    fi

    # Pass 3: match the directory against includeIf blocks in ~/.gitconfig.
    local matched_profile_file conf_id
    matched_profile_file="$(match_includefile "$current_dir" "$physical_dir")"
    if [ -n "$matched_profile_file" ]; then
        for conf in "${PROFILES_DIR}"/*.conf; do
            [ -f "$conf" ] || continue
            load_conf_valid "$conf" || continue
            # Derived from the filename like everywhere else; the conf value
            # is not trusted.
            conf_id="${conf##*/}"
            if [ "${PROFILES_DIR}/${conf_id%.conf}.gitconfig" = "$matched_profile_file" ]; then
                echo "Profile that would apply here: ${P_id}"
                echo "  name:     ${P_name}"
                echo "  email:    ${P_email}"
                echo "  base_dir: ${P_base_dir}"
                if [ "$in_repo" = 0 ]; then
                    echo "  (no git repo detected in this directory)"
                else
                    echo "  (matched by folder rule; this repo's own config does not use it)"
                fi
                return 0
            fi
        done
    fi

    echo "No matching profile found for this location."
}

# ── Main ─────────────────────────────────────────────────────────────────────

case "${1:-}" in
    create)
        shift
        cmd_create "$@"
        ;;
    list)
        cmd_list
        ;;
    delete)
        shift
        cmd_delete "$@"
        ;;
    use)
        shift
        cmd_use "$@"
        ;;
    use-folder)
        shift
        cmd_use_folder "$@"
        ;;
    current)
        cmd_current
        ;;
    version | --version | -v)
        echo "git-persona $VERSION"
        ;;
    help | --help | -h | "")
        usage
        ;;
    *)
        err "Unknown command: $1"
        usage >&2
        exit 1
        ;;
esac
