#!/bin/bash

# git-persona: manage multiple git identities with SSH keys and includeIf
# Usage: git-persona <command> [args]
# Version: 1.3.0
# License: MIT
# Dependencies: bash 4.0+, git 2.13+, openssh (ssh-keygen)

set -euo pipefail

VERSION="1.3.0"

CONFIG_DIR="${HOME}/.config/git-persona"
PROFILES_DIR="${CONFIG_DIR}/profiles"
SSH_DIR="${HOME}/.ssh"
GITCONFIG="${HOME}/.gitconfig"

init() {
    mkdir -p "$PROFILES_DIR"
    [ -f "$GITCONFIG" ] || touch "$GITCONFIG"
}

usage() {
    cat << 'EOF'
Usage: git-persona <command> [args]

Commands:
  create <id> <name> <email> [base_dir] [--no-ssh-key]
                                        Create a new profile (generates SSH key by default)
  list                                  List all profiles
  delete <id> [--with-keys]             Delete a profile (keeps SSH key by default)
  use <id>                              Apply profile to current repo
  use-folder <id> <folder>              Apply profile to a folder via includeIf
  current                               Show the profile for the current directory
  version                               Show the version of git-persona

Flags:
  --no-ssh-key    (create)  Skip SSH key generation
  --with-keys     (delete)  Also remove the SSH key pair

Examples:
  git persona create work "Work Name" work@example.com ~/work
  git persona create personal "Personal Name" personal@example.com ~/personal --no-ssh-key
  git persona use work
  git persona use-folder work ~/work
  git persona current
  git persona delete work --with-keys
  git persona version
EOF
}

profile_exists() {
    local id="$1"
    [ -f "${PROFILES_DIR}/${id}.conf" ]
}

# Escape a value for safe embedding inside double quotes in a bash-sourceable
# conf file. Inside double quotes bash expands $ and ` and \ and ", so all
# four must be escaped. Backslash first (it escapes the others), then the
# rest in any order.
shell_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\$/\\\$}"
    s="${s//\`/\\\`}"
    s="${s//\"/\\\"}"
    printf '%s' "$s"
}

get_field() {
    local id="$1"
    local field="$2"
    local conf="${PROFILES_DIR}/${id}.conf"
    [ -f "$conf" ] || return 1
    . "$conf"
    eval "echo \"\${${field}:-}\""
}

add_include_if() {
    local dir="$1"
    local profile_file="$2"
    local header="[includeIf \"gitdir:${dir}/\"]"

    # If no gitconfig exists yet, just append.
    [ -f "$GITCONFIG" ] || {
        printf "\n[includeIf \"gitdir:%s/\"]\n    path = %s\n" "$dir" "$profile_file" >> "$GITCONFIG"
        return 0
    }

    # Scan for an existing block with this exact directory header.
    # - Same path  -> no-op (true dedup).
    # - Different path -> update the path line in place (reassignment).
    # - No match   -> append a new block.
    local tmp_file="${GITCONFIG}.tmp.$$"
    local found_header=0
    local updated=0
    local line trimmed

    while IFS= read -r line || [ -n "$line" ]; do
        if [ "$found_header" = 1 ]; then
            trimmed="${line#"${line%%[![:space:]]*}"}"
            if [ "$trimmed" = "path = ${profile_file}" ]; then
                # Exact match — true dedup, copy through unchanged.
                printf '%s\n' "$line"
                found_header=0
                updated=1
                continue
            elif [ "${trimmed:0:6}" = "path =" ]; then
                # Header exists but points to a different profile — reassign.
                printf '    path = %s\n' "$profile_file"
                found_header=0
                updated=1
                continue
            fi
            # Not a path line — copy through, keep scanning for the path.
            printf '%s\n' "$line"
            continue
        fi

        if [ "$line" = "$header" ]; then
            found_header=1
        fi
        printf '%s\n' "$line"
    done < "$GITCONFIG" > "$tmp_file"

    if [ "$updated" = 1 ]; then
        mv "$tmp_file" "$GITCONFIG"
    else
        rm -f "$tmp_file"
        printf "\n[includeIf \"gitdir:%s/\"]\n    path = %s\n" "$dir" "$profile_file" >> "$GITCONFIG"
    fi
}

remove_include_if() {
    local profile_file="$1"
    [ -f "$GITCONFIG" ] || return 0

    local tmp_file
    tmp_file="${GITCONFIG}.tmp.$$"
    local in_block=0
    local saved_header=""
    local line
    local prev_blank=0

    while IFS= read -r line || [ -n "$line" ]; do
        if [ "$in_block" = 1 ]; then
            if [ -z "$line" ] || [ "${line:0:1}" = "[" ]; then
                printf '%s\n' "$saved_header"
                in_block=0
            else
                # Strip leading whitespace so any indent (spaces, tabs, or
                # unusual counts) is accepted, not just the 4-space/tab we write.
                local trimmed="${line#"${line%%[![:space:]]*}"}"
                if [ "$trimmed" = "path = ${profile_file}" ]; then
                    in_block=0
                    continue
                else
                    printf '%s\n' "$saved_header"
                    printf '%s\n' "$line"
                    in_block=0
                    continue
                fi
            fi
        fi

        # Detect start of an includeIf block
        if [ "${line:0:11}" = "[includeIf " ]; then
            in_block=1
            saved_header="$line"
            continue
        fi

        # Collapse multiple blank lines into one
        if [ -z "$line" ]; then
            if [ "$prev_blank" = 1 ]; then
                continue
            fi
            prev_blank=1
        else
            prev_blank=0
        fi

        printf '%s\n' "$line"
    done < "$GITCONFIG" > "$tmp_file"

    if [ "$in_block" = 1 ]; then
        printf '%s\n' "$saved_header" >> "$tmp_file"
    fi

    mv "$tmp_file" "$GITCONFIG"
}

cmd_create() {
    local generate_key=true
    local positional=()

    for arg in "$@"; do
        case "$arg" in
            --no-ssh-key)
                generate_key=false
                ;;
            *)
                positional+=("$arg")
                ;;
        esac
    done

    if [ "${#positional[@]}" -lt 3 ]; then
        echo "Usage: git-persona create <id> <name> <email> [base_dir] [--no-ssh-key]"
        exit 1
    fi

    local id="${positional[0]}"
    local name="${positional[1]}"
    local email="${positional[2]}"
    local base_dir="${positional[3]:-${HOME}/git-profiles/${id}}"
    base_dir="${base_dir%/}"
    base_dir="$(cd "$base_dir" 2>/dev/null && pwd || echo "$base_dir")"
    local key_file="${SSH_DIR}/id_ed25519_git_${id}"
    local profile_file="${PROFILES_DIR}/${id}.gitconfig"
    local conf_file="${PROFILES_DIR}/${id}.conf"

    init

    if profile_exists "$id"; then
        echo "Profile '$id' already exists."
        exit 1
    fi

    mkdir -p "$base_dir"

    if [ "$generate_key" = true ]; then
        if [ ! -f "$key_file" ]; then
            ssh-keygen -t ed25519 -C "$email" -f "$key_file" -N ""
        else
            echo "SSH key already exists at $key_file"
        fi
    fi

    # Build profile gitconfig — only set sshCommand if key exists
    if [ -f "$key_file" ]; then
        cat > "$profile_file" << EOF
[user]
    name = ${name}
    email = ${email}
[core]
    sshCommand = ssh -i ${key_file} -o IdentitiesOnly=yes
EOF
    else
        cat > "$profile_file" << EOF
[user]
    name = ${name}
    email = ${email}
EOF
    fi

    cat > "$conf_file" << EOF
id="${id}"
name="$(shell_escape "$name")"
email="$(shell_escape "$email")"
base_dir="$(shell_escape "$base_dir")"
key_file="$(shell_escape "$key_file")"
profile_file="$(shell_escape "$profile_file")"
EOF

    add_include_if "$base_dir" "$profile_file"

    echo "Profile '$id' created."
    echo "  Base directory: $base_dir"
    if [ -f "$key_file" ]; then
        echo "  SSH key:        $key_file"
        echo "  Public key:     ${key_file}.pub"
        echo ""
        echo "Add this public key to GitHub:"
        cat "${key_file}.pub"
        echo ""
    else
        echo "  SSH key:        (none — use --no-ssh-key was set or key not found)"
        echo ""
    fi
    echo "Put repos under $base_dir to automatically use this profile."
}

cmd_list() {
    init
    local count=0
    local conf

    echo "Profiles:"
    for conf in "${PROFILES_DIR}"/*.conf; do
        [ -f "$conf" ] || continue
        . "$conf"
        echo "  ${id}"
        echo "    name:     ${name}"
        echo "    email:    ${email}"
        echo "    base_dir: ${base_dir}"
        echo "    key:      ${key_file}"
        count=$((count + 1))
    done

    if [ "$count" -eq 0 ]; then
        echo "No profiles found."
    fi
}

cmd_delete() {
    local remove_keys=false
    local id=""

    for arg in "$@"; do
        case "$arg" in
            --with-keys)
                remove_keys=true
                ;;
            *)
                if [ -z "$id" ]; then
                    id="$arg"
                fi
                ;;
        esac
    done

    if [ -z "$id" ]; then
        echo "Usage: git-persona delete <id> [--with-keys]"
        exit 1
    fi

    init

    if ! profile_exists "$id"; then
        echo "Profile '$id' not found."
        exit 1
    fi

    local key_file profile_file base_dir
    key_file=$(get_field "$id" "key_file")
    profile_file=$(get_field "$id" "profile_file")
    base_dir=$(get_field "$id" "base_dir")

    if [ "$remove_keys" = true ]; then
        rm -f "$key_file" "${key_file}.pub"
        echo "SSH key removed: $key_file"
    else
        echo "SSH key kept: $key_file (use --with-keys to also remove it)"
    fi

    rm -f "$profile_file" "${PROFILES_DIR}/${id}.conf"
    remove_include_if "$profile_file"

    echo "Profile '$id' deleted."
    echo "Note: base directory $base_dir was not removed."
}

cmd_use() {
    if [ $# -lt 1 ]; then
        echo "Usage: git-persona use <id>"
        exit 1
    fi

    local id="$1"
    init

    if ! profile_exists "$id"; then
        echo "Profile '$id' not found."
        exit 1
    fi

    if [ ! -d ".git" ] && ! git rev-parse --git-dir >/dev/null 2>&1; then
        echo "Not a git repository. Run this from inside a repo."
        exit 1
    fi

    local name email key_file
    name=$(get_field "$id" "name")
    email=$(get_field "$id" "email")
    key_file=$(get_field "$id" "key_file")

    git config user.name "$name"
    git config user.email "$email"
    if [ -n "$key_file" ] && [ -f "$key_file" ]; then
        git config core.sshCommand "ssh -i ${key_file} -o IdentitiesOnly=yes"
    fi

    echo "Profile '$id' applied to current repo."
}

cmd_use_folder() {
    if [ $# -lt 2 ]; then
        echo "Usage: git-persona use-folder <id> <folder>"
        exit 1
    fi

    local id="$1"
    local folder="$2"
    init

    if ! profile_exists "$id"; then
        echo "Profile '$id' not found."
        exit 1
    fi

    if [ ! -d "$folder" ]; then
        echo "Folder does not exist: $folder"
        exit 1
    fi

    local profile_file
    profile_file=$(get_field "$id" "profile_file")

    folder=$(cd "$folder" && pwd)

    add_include_if "$folder" "$profile_file"

    echo "Profile '$id' applied to folder: $folder"
    echo "Any git repo under this folder will automatically use this profile."
}

cmd_current() {
    local current_dir
    current_dir="$(pwd)"

    local git_name git_email ssh_cmd
    git_name=""
    git_email=""
    ssh_cmd=""

    if [ -d ".git" ] || git rev-parse --git-dir >/dev/null 2>&1; then
        git_name="$(git config user.name 2>/dev/null || true)"
        git_email="$(git config user.email 2>/dev/null || true)"
        ssh_cmd="$(git config core.sshCommand 2>/dev/null || true)"
    fi

    # Pass 1: strongest signal — the SSH key in core.sshCommand uniquely
    # identifies a profile even when several share the same name+email.
    if [ -n "$ssh_cmd" ]; then
        for conf in "${PROFILES_DIR}"/*.conf; do
            [ -f "$conf" ] || continue
            . "$conf"
            if [ -n "$key_file" ]; then
                case "$ssh_cmd" in
                    *"$key_file"*)
                        echo "Current profile: $id"
                        echo "  name:  $name"
                        echo "  email: $email"
                        echo "  key:   $key_file"
                        return 0
                        ;;
                esac
            fi
        done
    fi

    # Pass 2: weaker signal — name+email. When multiple profiles share these,
    # the first match wins (there is no way to distinguish them further).
    if [ -n "$git_name" ] && [ -n "$git_email" ]; then
        for conf in "${PROFILES_DIR}"/*.conf; do
            [ -f "$conf" ] || continue
            . "$conf"
            if [ "$name" = "$git_name" ] && [ "$email" = "$git_email" ]; then
                echo "Current profile: $id"
                echo "  name:  $name"
                echo "  email: $email"
                echo "  key:   ${key_file:-}"
                return 0
            fi
        done
    fi

    for conf in "${PROFILES_DIR}"/*.conf; do
        [ -f "$conf" ] || continue
        . "$conf"

        if [ -n "$base_dir" ]; then
            case "$current_dir" in
                "$base_dir"|"$base_dir"/*)
                    echo "Profile that would apply here: $id"
                    echo "  name:     $name"
                    echo "  email:    $email"
                    echo "  base_dir: $base_dir"
                    echo "  (no git repo detected in this directory)"
                    return 0
                    ;;
            esac
        fi
    done

    echo "No matching profile found for this location."
}

# Main
init

case "${1:-}" in
    create)
        shift
        cmd_create "$@"
        ;;
    list)
        cmd_list
        ;;
    delete)
        shift
        cmd_delete "$@"
        ;;
    use)
        shift
        cmd_use "$@"
        ;;
    use-folder)
        shift
        cmd_use_folder "$@"
        ;;
    current)
        cmd_current
        ;;
    version|--version|-v)
        echo "git-persona $VERSION"
        ;;
    help|--help|-h|"")
        usage
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
